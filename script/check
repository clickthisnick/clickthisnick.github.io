#!/usr/bin/env bash
# One command for local runs and GitHub Actions. See AGENTS.md.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

echo "== tests =="
node --test test/site.test.js

echo "== html-validate =="
mapfile -t pages < <(find . -name '*.html' -not -path './node_modules/*' -not -path './.git/*')
npx html-validate "${pages[@]}"

echo "== links =="
npx linkinator index.html --recurse --silent --directory-listing --server-root . \
  --timeout 20000 --retry-errors --retry-errors-count 2 \
  --skip "itinerary" --skip "dynamic-release-checklist"

echo "== size budget =="
node script/size-budget.js
